{
  "permissions": {
    "deny": [
      "Read(.env)",
      "Read(.env.local)",
      "Read(.env.development)",
      "Read(.env.test)",
      "Read(.env.production)",
      "Read(backend/.env)",
      "Read(frontend/.env)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(credentials.json)",
      "Bash(cat *.env*)",
      "Bash(cat backend/.env*)"
    ]
  }
}
